  m_text: "<b>DIAGRAMA DE CIRCUITOS</b>\n<size=75%>Laboratorio de Qu\xEDmica</size>\n\n<align=left><size=80%><pos=0%><b>CIRC.</b><pos=17%><b>USO</b><pos=76%><b>CONSUMO</b>\n<pos=4%>A<pos=17%>Iluminaci\xF3n<pos=80%>8
    A\n<pos=4%>B<pos=17%>Campana extractora<pos=80%>14 A\n<pos=4%>C<pos=17%>V\xE1lvulas
    de gas<pos=80%>5 A</size></align>\n\n<size=80%>Cada circuito lleva el fusible
    normalizado\n<b>inmediatamente superior</b> a su consumo.\nSe enchufa en el portafusibles
    de su circuito.</size>\n\n<size=72%><color=#6b3b1a>4 A marr\xF3n</color> \xB7
    <color=#2e7d32>6 A verde</color> \xB7 <color=#c62828>10 A rojo</color>\n<color=#616161>16
    A gris</color> \xB7 <color=#1e4fb0>20 A azul</color> \xB7 <color=#b58900>25 A
    amarillo</color></size>"
