  m_Script: {fileID: 11500000, guid: 6ff4297d945ecc54eb5fcea2994974f2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PanelObjetivo
  texto: {fileID: 1871451189}
  pasos:
  - "<color=#fbbf24><b>\u2022  SUMINISTRO EL\xC9CTRICO<pos=74%>EN CURSO</b></color>\n<size=80%><color=#e2e8f0>   
    Tablero junto a la entrada: pon\xE9 en cada portafusibles (A, B, C) el fusible
    que le corresponde.</color></size>\n<color=#64748b>\u2022  EXTRACCI\xD3N DE GASES<pos=74%>PENDIENTE</color>\n<color=#64748b>\u2022 
    L\xCDNEA DE GAS<pos=74%>PENDIENTE</color>\n<color=#64748b>\u2022  ENSAYO A LA
    LLAMA<pos=74%>PENDIENTE</color>\n<color=#64748b>\u2022  SALIDA DE EMERGENCIA<pos=74%>PENDIENTE</color>\n"
  - "<color=#4ade80>\u2022  SUMINISTRO EL\xC9CTRICO<pos=74%>COMPLETO</color>\n<color=#fbbf24><b>\u2022 
    EXTRACCI\xD3N DE GASES<pos=74%>EN CURSO</b></color>\n<size=80%><color=#e2e8f0>   
    Campana (pared izquierda): baj\xE1 el vidrio y pon\xE9 el extractor en 3.</color></size>\n<color=#64748b>\u2022 
    L\xCDNEA DE GAS<pos=74%>PENDIENTE</color>\n<color=#64748b>\u2022  ENSAYO A LA
    LLAMA<pos=74%>PENDIENTE</color>\n<color=#64748b>\u2022  SALIDA DE EMERGENCIA<pos=74%>PENDIENTE</color>\n"
  - "<color=#4ade80>\u2022  SUMINISTRO EL\xC9CTRICO<pos=74%>COMPLETO</color>\n<color=#4ade80>\u2022 
    EXTRACCI\xD3N DE GASES<pos=74%>COMPLETO</color>\n<color=#fbbf24><b>\u2022  L\xCDNEA
    DE GAS<pos=74%>EN CURSO</b></color>\n<size=80%><color=#e2e8f0>    Llaves de gas
    (pared derecha): abr\xED V1 y V2 girando el volante hasta el tope.</color></size>\n<color=#64748b>\u2022 
    ENSAYO A LA LLAMA<pos=74%>PENDIENTE</color>\n<color=#64748b>\u2022  SALIDA DE
    EMERGENCIA<pos=74%>PENDIENTE</color>\n"
  - "<color=#4ade80>\u2022  SUMINISTRO EL\xC9CTRICO<pos=74%>COMPLETO</color>\n<color=#4ade80>\u2022 
    EXTRACCI\xD3N DE GASES<pos=74%>COMPLETO</color>\n<color=#4ade80>\u2022  L\xCDNEA
    DE GAS<pos=74%>COMPLETO</color>\n<color=#fbbf24><b>\u2022  ENSAYO A LA LLAMA<pos=74%>EN
    CURSO</b></color>\n<size=80%><color=#e2e8f0>    Mesada: el color de la llama
    dice el metal de cada muestra. Baj\xE1 sus palancas en orden 1, 2, 3.</color></size>\n<color=#64748b>\u2022 
    SALIDA DE EMERGENCIA<pos=74%>PENDIENTE</color>\n"
  - "<color=#4ade80>\u2022  SUMINISTRO EL\xC9CTRICO<pos=74%>COMPLETO</color>\n<color=#4ade80>\u2022 
    EXTRACCI\xD3N DE GASES<pos=74%>COMPLETO</color>\n<color=#4ade80>\u2022  L\xCDNEA
    DE GAS<pos=74%>COMPLETO</color>\n<color=#4ade80>\u2022  ENSAYO A LA LLAMA<pos=74%>COMPLETO</color>\n<color=#fbbf24><b>\u2022 
    SALIDA DE EMERGENCIA<pos=74%>EN CURSO</b></color>\n<size=80%><color=#e2e8f0>   
    Casillero del docente abierto: su tarjeta abre la salida (lector junto a la puerta).</color></size>\n"
  - "<color=#4ade80>\u2022  SUMINISTRO EL\xC9CTRICO<pos=74%>COMPLETO</color>\n<color=#4ade80>\u2022 
    EXTRACCI\xD3N DE GASES<pos=74%>COMPLETO</color>\n<color=#4ade80>\u2022  L\xCDNEA
    DE GAS<pos=74%>COMPLETO</color>\n<color=#4ade80>\u2022  ENSAYO A LA LLAMA<pos=74%>COMPLETO</color>\n<color=#4ade80>\u2022 
    SALIDA DE EMERGENCIA<pos=74%>COMPLETO</color>\n\n<color=#4ade80><b>EVACUACI\xD3N
    AUTORIZADA: la salida est\xE1 abierta.</b></color>"
