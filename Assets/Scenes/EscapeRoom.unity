  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. Sin luz no funciona nada: subi la llave\n    del tablero, al lado de
    la puerta.\n\n2. Los 5 relojes se pararon a las 4:40.\n    Hay que ponerlos en
    hora.\n\n3. La bitacora, sobre el mueble largo,\n    dice a que hora suena cada
    campana.\n\n4. La placa debajo del cuadro dice que\n    reloj es cada campana.\n\n5.
    Agarra la aguja corta de cada reloj y\n    girala hasta su hora: se enciende
    y\n    muestra un numero.\n    El reloj que no esta en la placa:\n    NO LO TOQUES.\n\n6.
    Marca los numeros en el teclado de la\n    salida, en el orden de la bitacora.\n\n7.
    Llevate el medallon del cajon."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
