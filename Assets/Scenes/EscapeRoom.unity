      m_Calls: []
  m_text: "<b>REGISTRO DE MANTENIMIENTO</b>\nSala de Computaci\xF3n\n\n12/09 \u2014
    Tablero de luces:\nel interruptor 2 qued\xF3 cruzado\ncon el circuito del proyector.\n\n<b>NO
    USAR EL 2.</b> Con los otros\ntres se enciende toda la sala.\n\n\u2014 T\xE9cnico:
    R. Quispe"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
