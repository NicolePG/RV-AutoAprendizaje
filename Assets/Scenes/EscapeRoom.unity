  m_text: "<b>PROTOCOLO DE SEGURIDAD\nL\xCDNEA DE GAS</b>\n\n<align=left><size=85%>1.
    Bajar el vidrio de la campana de extracci\xF3n.\n2. Poner el extractor en velocidad
    3.\n3. Abrir V1 y V2: girar el volante en sentido\n    horario (a la derecha)
    hasta el tope.</size></align>\n\n<size=80%><b>Sin extracci\xF3n la l\xEDnea queda
    bloqueada.</b></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
