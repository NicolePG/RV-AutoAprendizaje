  m_Script: {fileID: 11500000, guid: 6ff4297d945ecc54eb5fcea2994974f2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PanelObjetivo
  texto: {fileID: 142574661}
  pasos:
  - "<b>SIN ENERG\xCDA</b>\nEl tablero el\xE9ctrico junto a la entrada necesita\nsus
    3 fusibles. Le\xE9 el diagrama de circuitos."
  - "<b>VOLVI\xD3 LA LUZ</b>\nAntes de abrir el gas hay que preparar la campana\nde
    extracci\xF3n: le\xE9 el protocolo junto a la l\xEDnea de gas."
  - "<b>EXTRACCI\xD3N OK</b>\nAbr\xED las llaves de gas V1 y V2 (pared Este)\ngirando
    el volante hasta el tope."
  - "<b>HAY GAS</b>\nHac\xE9 el ensayo a la llama de las muestras 1, 2 y 3\ny baj\xE1
    las palancas de la salida en ese orden."
  - "<b>SALIDA HABILITADA</b>\nColoc\xE1 el medall\xF3n del Cuarto 2 en la ranura\njunto
    a la puerta y giralo."
  - "<b>\xA1ESCAPASTE!</b>\nLa salida de emergencia est\xE1 abierta."
