  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>PR\xC1CTICA N\xB0 7 \xB7 ENSAYO A LA LLAMA</b>\n\n<align=left><size=80%>1.
    Tomar una muestra de la gradilla (1, 2 o 3).\n2. Meter la punta en la llama de
    un mechero.\n3. Mirar el color de la llama y buscar el metal:</size></align>\n\n<b><color=#2e7d32>VERDE
    = COBRE (Cu)</color>\n<color=#b07d00>AMARILLA = SODIO (Na)</color>\n<color=#c62828>ROJA
    = LITIO (Li)</color>\n<color=#6a1b9a>VIOLETA = POTASIO (K)</color></b>\n\n<size=75%>Con
    el metal de cada muestra se bajan las\npalancas del cierre de la salida (pared
    del fondo).</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
